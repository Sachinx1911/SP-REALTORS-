# Production .env reference for SP REALTORS on Hostinger (Business Web Hosting).
#
# Copy this to `.env` on the server (NOT into git — .env is gitignored on purpose)
# and fill in the blanks with your real database credentials and mail settings.
# After editing, run:
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# See README.md section 4 ("Production deployment") for the full step-by-step.

APP_NAME="SP REALTORS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sprealtors.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

BCRYPT_ROUNDS=12

# --- Database (from hPanel → Databases → MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions: secure cookies only work once the site is served over HTTPS ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail: enquiries are emailed here. Use Hostinger's mail account or an SMTP
# provider (e.g. Gmail with an app password, Brevo, Resend). MAIL_MAILER=log
# (the local-dev default) silently drops every enquiry email — never use it live. ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@sprealtors.in"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
